# ==============================================================================
# VerityScout AI — Production Environment Configuration Template
# ==============================================================================
# Supply these variables via your production secret management system
# (e.g. AWS Secrets Manager, Doppler, Vault, or protected platform environment variables).
# Rule: NEVER commit real credentials to git or store unencrypted in repository.
# ==============================================================================

NODE_ENV=production
APP_ENV=production
LOG_LEVEL=warn
APP_URL=https://verityscout.example.com
PORT=3000

# Production Database (Managed PostgreSQL / Supabase / Dedicated VPS)
# Use DATABASE_URL or individual POSTGRES_* parameters with SSL enabled.
# DATABASE_URL=postgresql://app_user:strong_prod_password@prod-db.example.internal:5432/verityscout_prod?sslmode=require
POSTGRES_HOST=prod-db.example.internal
POSTGRES_PORT=5432
POSTGRES_USER=verityscout_prod
POSTGRES_PASSWORD=replace_with_strong_production_password
POSTGRES_DB=verityscout_prod
POSTGRES_SSL=true
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Production Credential Vault Key (AES-256-GCM 256-bit Key)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STRICT: Default dev key will cause immediate fatal crash on boot.
VAULT_MASTER_KEY=replace_with_secure_random_64_character_hex_key
VAULT_ACTIVE_KEY_VERSION=1

# Optional Keyring for Key Rotation
# VAULT_KEYRING={"1":"old_key_hex...","2":"new_key_hex..."}


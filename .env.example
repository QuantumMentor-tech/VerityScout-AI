# ==============================================================================
# VerityScout AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development overrides.
# Rule: NEVER commit real credentials, tokens, or private secrets to git.
# Rule: Variables prefixed with NEXT_PUBLIC_ are inlined into client bundles.

# Runtime Environment (development | test | production)
NODE_ENV=development

# Logging Severity Threshold (debug | info | warn | error)
LOG_LEVEL=info

# Application Base URL
APP_URL=http://localhost:3000

# Server HTTP Port
PORT=3000

# ------------------------------------------------------------------------------
# Future / Planned Subsystems (Intentionally Deferred to Subsequent Phases)
# ------------------------------------------------------------------------------
# The following variables will be defined when their subsystems are implemented:
# - Database & Supabase: DATABASE_URL, SUPABASE_URL, SUPABASE_ANON_KEY (Phase 6)
# - Redis & Queue: REDIS_URL (Phase 6)
# - Search Providers: TAVILY_API_KEY, EXA_API_KEY (Phase 3)
# - AI LLM Providers: OPENAI_API_KEY, OPENROUTER_API_KEY, NVIDIA_NIM_API_KEY (Phase 5)
# ------------------------------------------------------------------------------

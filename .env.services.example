# ==============================================================================
# VerityScout AI — Local Services Environment Template
# ==============================================================================
# Copy this file to .env.services for local Docker Compose overrides.
# Rule: NEVER commit .env.services with real or production passwords.
# Rule: These settings are strictly for local loopback development containers.

# Local PostgreSQL Configuration
POSTGRES_USER=verityscout
POSTGRES_PASSWORD=verityscout_dev_password
POSTGRES_DB=verityscout_dev
POSTGRES_PORT=5432

# Local Redis Configuration
REDIS_PASSWORD=verityscout_redis_dev
REDIS_PORT=6379

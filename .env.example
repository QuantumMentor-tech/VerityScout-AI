# ==============================================================================
# VerityScout AI — Environment Configuration Reference & Baseline Template
# ==============================================================================
# Governed by: ADR-009, ADR-010, ADR-012, Step 58 (Staging & Production Deployment).
# Rule: NEVER commit real credentials, tokens, or private secrets to git.
# Rule: Variables prefixed with NEXT_PUBLIC_ are inlined into client browser bundles.
#
# ENVIRONMENT SEPARATION:
# - Development: NODE_ENV=development, APP_ENV=development (Local coding & testing)
# - Staging:     NODE_ENV=production,  APP_ENV=staging     (Pre-release validation)
# - Production:  NODE_ENV=production,  APP_ENV=production  (Production runtime)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & PROCESS CONFIGURATION
# ------------------------------------------------------------------------------
# NODE_ENV: Runtime compilation mode (development | test | production).
# Required: No (default: development). Sensitive: No.
NODE_ENV=development

# APP_ENV: Deployment environment tier (development | staging | production).
# Required: No (default: development). Sensitive: No.
# Controls strict production credential checks and resource isolation.
APP_ENV=development

# LOG_LEVEL: Minimum logging severity (debug | info | warn | error).
# Required: No (default: info). Sensitive: No.
LOG_LEVEL=info

# APP_URL: Fully qualified public URL where the application is reached.
# Required: No (default: http://localhost:3000). Sensitive: No.
# Production must use HTTPS and cannot be localhost or loopback.
APP_URL=http://localhost:3000

# PORT: Local TCP port for the Next.js HTTP server.
# Required: No (default: 3000). Sensitive: No.
PORT=3000

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE POOLING (PostgreSQL 16)
# ------------------------------------------------------------------------------
# DATABASE_URL: Optional unified connection string (e.g., postgresql://user:pass@host:5432/db).
# Required: No (if individual POSTGRES_* variables are supplied). Sensitive: Yes.
# DATABASE_URL=postgresql://verityscout:verityscout_dev_password@127.0.0.1:5432/verityscout_dev

# POSTGRES_HOST: PostgreSQL host address or container hostname.
# Required: No (default: 127.0.0.1). Sensitive: No.
POSTGRES_HOST=127.0.0.1

# POSTGRES_PORT: PostgreSQL TCP port.
# Required: No (default: 5432). Sensitive: No.
POSTGRES_PORT=5432

# POSTGRES_USER: PostgreSQL database username.
# Required: No (default: verityscout). Sensitive: No.
POSTGRES_USER=verityscout

# POSTGRES_PASSWORD: Password for the PostgreSQL user.
# Required: Yes in production. Sensitive: Yes.
POSTGRES_PASSWORD=verityscout_dev_password

# POSTGRES_DB: Primary database schema/catalog name.
# Required: No (default: verityscout_dev). Sensitive: No.
POSTGRES_DB=verityscout_dev

# POSTGRES_SSL: Whether SSL/TLS encryption is required for DB connections (true | false).
# Required: No (default: false). Sensitive: No. Set to true for cloud-hosted DBs.
POSTGRES_SSL=false

# DATABASE_POOL_MAX: Maximum concurrent connections in the connection pool.
# Required: No (default: 10). Sensitive: No. Range: 1-100.
DATABASE_POOL_MAX=10

# DATABASE_POOL_IDLE_TIMEOUT_MS: Milliseconds before an idle client is closed.
# Required: No (default: 30000). Sensitive: No.
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# DATABASE_POOL_CONNECTION_TIMEOUT_MS: Milliseconds before timing out a connection attempt.
# Required: No (default: 5000). Sensitive: No.
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. CREDENTIAL VAULT ENCRYPTION (AES-256-GCM)
# ------------------------------------------------------------------------------
# VAULT_MASTER_KEY: 64-character hexadecimal string representing a 256-bit encryption key.
# Required: Yes. Sensitive: CRITICAL.
# In production, using the default development key triggers fatal startup validation.
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# VAULT_KEYRING: Optional JSON-encoded versioned keyring for seamless zero-downtime key rotation.
# Required: No. Sensitive: CRITICAL. Format: {"1": "64hex...", "2": "64hex..."}
# VAULT_KEYRING={"1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}

# VAULT_ACTIVE_KEY_VERSION: Numeric version ID to use when encrypting new provider credentials.
# Required: No (default: 1). Sensitive: No.
VAULT_ACTIVE_KEY_VERSION=1

# ------------------------------------------------------------------------------
# 4. OPTIONAL OVERRIDES
# ------------------------------------------------------------------------------
# ALLOW_INSECURE_HTTP_IN_PRODUCTION: Allows HTTP APP_URL in production tier (e.g. internal VPC).
# Required: No (default: false). Sensitive: No.
ALLOW_INSECURE_HTTP_IN_PRODUCTION=false
